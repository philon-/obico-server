# Debug?
# DEBUG=False

# Port to listen to
# ML_API_PORT=3333

# Host to listen to
# ML_API_HOST=0.0.0.0

# Session TTL
# SESSION_TTL_SECONDS=120

# API token
# ML_API_TOKEN=

# If we want to read from an image file instead of the ?img= argument
ML_INPUT_IMAGE=/app/image.jpg

# If we want to render the boxes we can do that to this file
ML_OUTPUT_IMAGE=/app/output.jpg

# Add confidence to output file?
ML_OUTPUT_TEXT=True

# NMS threshold
# ML_NMS=0.45

# DET threshold
# ML_THRESH=0.08

# https://docs.sentry.io/product/sentry-basics/dsn-explainer/
# SENTRY_DSN=